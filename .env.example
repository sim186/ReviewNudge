# Copy to .env and fill in. Every value here is referenced from config.yaml
# as ${VAR_NAME}, so secrets never live in the config file itself.

# GitLab personal access token. Scope: read_api.
# The scope is only half of it — the token's user also needs a role on the projects.
# Reporter is the safe answer: the Guest role cannot view merge requests on private
# projects, which fails silently as empty scans rather than an error.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Password for the admin panel login form.
NUDGE_ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random secret is generated at startup and sessions drop on restart.
NUDGE_SESSION_SECRET=

# SMTP password for the email channel.
SMTP_PASS=

# Power Automate "When a Teams webhook request is received" URL.
TEAMS_WORKFLOW_URL=

# Slack bot token (xoxb-…) with the chat:write scope, for direct messages.
SLACK_BOT_TOKEN=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional operational overrides.
# NUDGE_CONFIG=config/config.yaml
# NUDGE_DATA_DIR=data
# NUDGE_DRY_RUN=1     # render digests but never deliver them
# NUDGE_SILENCE=1     # global pause, equivalent to the panel toggle
# LOG_LEVEL=info

# The pre-rename MRA_* names are still read as a fallback, so an existing .env
# keeps working; NUDGE_* wins wherever both are set.
